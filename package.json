{
  "name": "@mvagnon/opencode-mcp",
  "version": "1.0.0",
  "description": "MCP server (stdio) exposing ask_codebase — read-only Q&A over GitHub repositories via opencode",
  "type": "module",
  "bin": {
    "opencode-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "opencode",
    "github",
    "codebase",
    "code-analysis",
    "ai",
    "llm"
  ],
  "author": "Matthieu Vagnon <hi@mvagnon.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvagnon/opencode-mcp.git"
  },
  "homepage": "https://github.com/mvagnon/opencode-mcp#readme",
  "bugs": {
    "url": "https://github.com/mvagnon/opencode-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/*.test.ts'",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.7.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.64.0"
  }
}
